{
  "$schema": "../schema/entry.schema.json",
  "slug": "renovate",
  "name": "Renovate (self-hosted)",
  "vendor": "Mend.io",
  "category": "dependencies",
  "website": "https://docs.renovatebot.com",
  "documentation_url": "https://docs.renovatebot.com/modules/platform/github/",
  "own_app": "optional",
  "supports": {
    "user": true,
    "org": true,
    "enterprise": false,
    "ghes": true
  },
  "install_scope": {
    "repositories": "either",
    "level": "org-or-user"
  },
  "credentials_needed": [
    "app_id",
    "private_key"
  ],
  "two_step_webhook": false,
  "manual_steps": [
    "Generate a private key. Renovate needs an installation access token (ghs_\u2026), which expires after an hour: regenerate it from the app ID and key, for example with actions/create-github-app-token."
  ],
  "notes": "Renovate's docs say the homepage URL, callback URL and webhook can be disabled or filled with dummy values. Merge queues write is only needed when repositories use a merge queue.",
  "manifest": {
    "name": "Renovate",
    "url": "https://docs.renovatebot.com",
    "hook_attributes": {
      "url": "https://example.invalid/webhook-not-used",
      "active": false
    },
    "public": false,
    "default_permissions": {
      "administration": "read",
      "checks": "write",
      "contents": "write",
      "issues": "write",
      "members": "read",
      "merge_queues": "write",
      "metadata": "read",
      "pull_requests": "write",
      "statuses": "write",
      "vulnerability_alerts": "read",
      "workflows": "write"
    },
    "default_events": []
  },
  "last_verified": null,
  "verified_by": null,
  "verification": {
    "status": "needs-review",
    "method": "doc-hash",
    "doc_hash": null
  },
  "changelog": [
    {
      "date": "2026-10-15",
      "version": "1.0.0",
      "author": "zmckenzie",
      "summary": "Initial entry from the vendor's documentation, read on 2026-10-15. Awaiting maintainer verification."
    }
  ]
}
