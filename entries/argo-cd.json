{
  "$schema": "../schema/entry.schema.json",
  "slug": "argo-cd",
  "name": "Argo CD",
  "vendor": "Argo Project (CNCF)",
  "category": "gitops",
  "website": "https://argoproj.github.io/cd/",
  "documentation_url": "https://argo-cd.readthedocs.io/en/latest/user-guide/private-repositories/",
  "own_app": "optional",
  "supports": {
    "user": true,
    "org": true,
    "enterprise": false,
    "ghes": true
  },
  "install_scope": {
    "repositories": "either",
    "level": "org-or-user"
  },
  "credentials_needed": [
    "app_id",
    "installation_id",
    "private_key"
  ],
  "two_step_webhook": false,
  "manual_steps": [
    "Generate a private key and add it to Argo CD with the app ID (CLI: argocd repo add \u2026 --github-app-id \u2026 --github-app-private-key-path \u2026).",
    "The installation ID is optional: Argo CD discovers it from the repository's organization."
  ],
  "notes": "The docs give Contents read-only as the minimum. For GitHub Enterprise, also pass the enterprise API base URL.",
  "manifest": {
    "name": "Argo CD",
    "url": "https://argoproj.github.io/cd/",
    "hook_attributes": {
      "url": "https://example.invalid/webhook-not-used",
      "active": false
    },
    "public": false,
    "default_permissions": {
      "contents": "read",
      "metadata": "read"
    },
    "default_events": []
  },
