{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zmckenzie/byoghapp/schema/entry.schema.json",
  "title": "byoghapp registry entry",
  "description": "One product that asks customers to register their own GitHub App. Cross-file rules (permission keys, events, changelog history) are enforced by scripts/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "name", "vendor", "category", "website", "documentation_url", "own_app",
    "supports", "install_scope", "credentials_needed", "two_step_webhook", "manual_steps",
    "manifest", "last_verified", "verified_by", "verification", "changelog"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "vendor": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "website": { "$ref": "#/$defs/httpsUrl" },
    "documentation_url": { "$ref": "#/$defs/httpsUrl" },
    "documentation_urls": {
      "description": "Further vendor pages the entry relies on, in addition to documentation_url.",
      "type": "array",
      "items": { "$ref": "#/$defs/httpsUrl" },
      "uniqueItems": true
    },
    "own_app": { "enum": ["required", "optional", "ghes-only"] },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "org", "enterprise", "ghes"],
      "properties": {
        "user": { "type": "boolean" },
        "org": { "type": "boolean" },
        "enterprise": { "type": "boolean" },
        "ghes": { "type": "boolean" }
      }
    },
    "install_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "level"],
      "properties": {
        "repositories": { "enum": ["all", "selected", "either"] },
        "level": { "enum": ["user", "org", "org-or-user", "enterprise"] },
        "notes": { "type": "string", "maxLength": 300 }
      }
    },
    "credentials_needed": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["app_id", "client_id", "client_secret", "private_key", "webhook_secret", "installation_id"] }
    },
    "two_step_webhook": {
      "description": "True when the webhook URL is only known after the vendor side is set up, or depends on the customer's own host. The stored URL is then a placeholder under https://example.invalid/.",
      "type": "boolean"
    },
    "manual_steps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "notes": { "type": "string", "maxLength": 1200 },
    "manifest": { "$ref": "#/$defs/manifest" },
    "variants": {
      "description": "Alternative permission sets for different feature sets. The first variant should match manifest.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "default_permissions", "default_events"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 300 },
          "default_permissions": { "$ref": "#/$defs/permissions" },
          "default_events": { "$ref": "#/$defs/events" }
        }
      }
    },
    "last_verified": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "verified_by": { "oneOf": [{ "$ref": "#/$defs/login" }, { "type": "null" }] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "doc_hash"],
      "properties": {
        "status": { "enum": ["ok", "needs-review", "failed"] },
        "method": { "enum": ["doc-hash", "manual"] },
        "doc_hash": { "oneOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }] }
      }
    },
    "changelog": {
      "description": "Newest first.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "version", "author", "summary"],
        "properties": {
          "date": { "$ref": "#/$defs/date" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "author": { "$ref": "#/$defs/login" },
          "pr": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s/$.?#][^\\s]*$", "maxLength": 2000 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "login": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "permissions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": { "enum": ["read", "write", "admin"] }
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "manifest": {
      "description": "GitHub's app manifest shape. redirect_url is omitted: the site sets it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "hook_attributes", "public", "default_permissions", "default_events"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 34 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "description": { "type": "string", "maxLength": 400 },
        "hook_attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "active"],
          "properties": {
            "url": { "$ref": "#/$defs/httpsUrl" },
            "active": { "type": "boolean" }
          }
        },
        "callback_urls": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUrl" } },
        "setup_url": { "$ref": "#/$defs/httpsUrl" },
        "setup_on_update": { "type": "boolean" },
        "request_oauth_on_install": { "type": "boolean" },
        "public": { "type": "boolean" },
        "default_permissions": { "$ref": "#/$defs/permissions" },
        "default_events": { "$ref": "#/$defs/events" }
      }
    }
  }
}
